# =============================================================================
# DATABASE
# =============================================================================
# Local Docker PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/erp_db"

# For Neon/Supabase, use their connection string with pooling:
# DATABASE_URL="postgresql://user:password@host/db?pgbouncer=true&connection_limit=1"

# DIRECT_URL is required for Prisma migrations on Neon (bypasses PgBouncer)
DIRECT_URL="postgresql://erp_user:erp_password@localhost:5432/erp_db"

# =============================================================================
# AUTH.JS (NextAuth v5)
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# APPLICATION
# =============================================================================
NEXT_PUBLIC_APP_NAME="نظام إدارة المحامل"
NEXT_PUBLIC_APP_NAME_EN="Bearings ERP"
NEXT_PUBLIC_DEFAULT_CURRENCY="EGP"
NEXT_PUBLIC_DEFAULT_LANGUAGE="ar"

# =============================================================================
# FILE UPLOAD
# =============================================================================
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="5"

# =============================================================================
# RATE LIMITING (optional - requires Upstash Redis)
# =============================================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
